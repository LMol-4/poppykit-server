{
  "name": "@poppykit/server",
  "version": "0.1.1",
  "private": false,
  "description": "Personal Agent Protocol company SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/LMol-4/poppykit-server.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc",
    "pack": "pnpm pack",
    "test": "npm run build:tests && node scripts/run-checks.mjs all",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "build:tests": "node scripts/build-tests.mjs",
    "coverage": "npm run build && npm run build:tests && node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "STORAGE.md",
    "AUTH.md",
    "DELIVERY.md",
    "INTEGRATIONS.md",
    "API.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "examples",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter-contract": {
      "types": "./dist/adapter-contract.d.ts",
      "import": "./dist/adapter-contract.js"
    },
    "./reference-auth": {
      "types": "./dist/reference-auth/index.d.ts",
      "import": "./dist/reference-auth/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
